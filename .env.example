# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO LOCAL PARA GOOGLE ADK 2.0
# ==============================================================================

# Proveedor por defecto para el curso: "ollama", "lmstudio", o "mlx"
LOCAL_LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 1. Configuración de OLLAMA (Por defecto en http://localhost:11434)
# ------------------------------------------------------------------------------
# Modelos recomendados con buen soporte de tool-calling / function calling:
# - qwen2.5:7b-instruct  (Excelente en herramientas y razonamiento)
# - llama3.1:8b-instruct (Rápido y estándar de la industria)
# - mistral-nemo:12b     (Gran ventana de contexto y precisión)
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 2. Configuración de LM STUDIO (Servidor local OpenAI compatible en :1234)
# ------------------------------------------------------------------------------
# Inicia el "Local Server" en LM Studio con un modelo cargado (ej. Qwen 2.5 7B)
LMSTUDIO_MODEL=qwen2.5-7b-instruct
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=not-needed

# ------------------------------------------------------------------------------
# 3. Configuración de MLX / Apple Silicon (mlx-lm server o LocalAI en :8080)
# ------------------------------------------------------------------------------
# Iniciar con: python -m mlx_lm.server --model mlx-community/Qwen2.5-7B-Instruct-4bit --port 8080
MLX_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
MLX_BASE_URL=http://localhost:8080/v1
MLX_API_KEY=not-needed

# ------------------------------------------------------------------------------
# 4. Parámetros opcionales de generación
# ------------------------------------------------------------------------------
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=1024
